  "postText": "<p><HTML><HEAD><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"></HEAD><body></p>\n<div align=\"center\"><img src=\"/blog/wp-content/uploads/mail-contents/2142/204/6f114dd4cd28740b84ed66754996e510..jpg\"></div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">こんばんは</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">今日は～</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">みなさんどうでしたか～</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">わたしは～</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">化粧をちょっと変えてみたら～</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">いい感じになりました～</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\"><img src=\"/blog/wp-content/uploads/mail-contents/2142/204/69b5bee38175def8f0f87d6c942c6697..jpg\"></div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">ふっ W</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">学校から美容室までの時間が</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">5時間くらいあったので</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">あむちゃんを</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">ご飯に誘ってみました。</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">そしたら、なんてこと</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">ほかの女とご飯を食べるんですって。</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">あーこわいこわい。</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">でも、私は許します。</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">偉いので😭</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">てことで</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\"><img src=\"/blog/wp-content/uploads/mail-contents/2142/204/d39b93d78973f9a7cdf3262b542a6301..jpg\"></div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">1人ラーメンだったわけですわ</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">みんな俺流って当てててすご！なった</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">おとこもりしか✨</div>\n<div align=\"center\"></div>\n<div align=\"center\"></div>\n<p></body></HTML></p>\n",
