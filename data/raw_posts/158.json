  "postText": "<p><HTML><HEAD><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"></HEAD><body></p>\n<div align=\"center\"><img src=\"/blog/wp-content/uploads/mail-contents/2142/158/4da620a0a328db24bcb240197de05eea..jpg\"></div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">暑ー！！！！うれしー！！！！あついー！！</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">マホガコに半袖で着てる人とかいて</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">うれしかった。</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">私</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">寒いし、孤独に苛まれるし</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">冬があまり好きじゃないんだけど</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">冬がいなかったら</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">夏を好きになってなかったのかもしれない</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">とおもったら</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">全てを愛さなきゃ…！とおもった</div>\n<div align=\"center\">&nbsp;</div>\n<div align=\"center\">そうだよね、そうだわ</div>\n<div align=\"center\">&nbsp;</div>\n<p></body></HTML></p>\n",
